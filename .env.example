# Copy to .env and fill in real values. Never commit a real .env or a real key.

# Server wallet key (required). Hex-encoded private key for the app's wallet.
# Provide via your deployment secret store; there is no in-source fallback.
SERVER_PRIVATE_KEY=replace-with-hex-private-key

# Wallet storage backend (optional; defaults to https://store-us-1.bsvb.tech).
WALLET_STORAGE_URL=https://store-us-1.bsvb.tech

# Float read-only treasury balance monitor. Bearer token the Float poller
# presents to GET /treasury/balance. When unset, that route is not exposed, so
# the app deploys unchanged until the token ships. Provisioned per app by Float
# and rotated independently of any key. Use a random string of 16+ characters.
FLOAT_BALANCE_TOKEN=replace-with-random-32-char-token
